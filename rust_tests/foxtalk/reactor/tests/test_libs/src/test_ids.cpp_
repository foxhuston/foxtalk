#include <vector>
#include <string>
#include <iostream>

#include "reactor.h"

static char *isA = "is a";
static char *husky = "husky";

struct Dog
{
    std::string name;
};

Tuple GetQuery()
{

    auto s = mk_tuple_noun_query();
    auto p = mk_tuple_noun_symbol("is a");
    auto o = mk_tuple_noun_symbol("husky");
    return mk_tuple(
        s,
        p,
        o
    );
}

// When (you) is a "husky"
std::vector<Tuple> *WhenHandler(Tuple *result)
{
    std::cout << "Hello from C++ WhenHandler" << std::endl;
    std::cout << "Subject is " << result->subject << std::endl;

    auto subj = get_tuple_subject(result);
    auto pred = get_tuple_predicate(result);
    auto outTuple = mk_tuple(
        subj,
        mk_tuple_noun_symbol("is a"),
        mk_tuple_noun_symbol("dog")
    );

    auto outTuple2 = mk_tuple(
        subj,
        pred,
        mk_tuple_noun_symbol("bunny")
    );

    auto out = new std::vector<Tuple>{outTuple2};
    return out;
}

