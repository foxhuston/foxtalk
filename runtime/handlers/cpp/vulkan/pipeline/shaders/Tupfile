.gitignore

import HANDLER_INCLUDE_PATH=/home/lexi/work/foxtalk/runtime/lib/cpp/include


: foreach src/* |> glslc %f -o %B.%e.spv |> %B.%e.spv

PKG_LIBS=`pkg-config --libs vulkan`

: shader.cpp |> clang++ -MJ %B.json -fPIC -O0 -g --std=c++26 -c -I$(HANDLER_INCLUDE_PATH) -o %o %f |> %B.o | %B.json {objs}

: {objs} |> clang++ -shared -fPIC $(PKG_LIBS) -o %o %f |> shader.so