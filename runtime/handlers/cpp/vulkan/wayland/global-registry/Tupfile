.gitignore

# Comment out when running from foxtalk
import HANDLER_INCLUDE_PATH=/home/lexi/work/foxtalk/runtime/lib/cpp/include



PKG_LIBS=`pkg-config --libs wayland-client`
WAYLAND_PROTOCOL_DIR=`pkg-config --variable=pkgdatadir wayland-protocols`
WAYLAND_XDG_SHELL_XML_PATH=$(WAYLAND_PROTOCOL_DIR)/stable/xdg-shell/xdg-shell.xml
# PKG_HEADERS=`pkg-config --cflags wayland-client`

: |> wayland-scanner client-header $(WAYLAND_XDG_SHELL_XML_PATH) %o |> xdg-shell.h
: |> wayland-scanner code $(WAYLAND_XDG_SHELL_XML_PATH) %o |> xdg-shell.c

: xdg-shell.c |> clang -MJ %B.json -fPIC -c -o %o %f |> xdg-shell.o | xdg-shell.json {objs}

: wayland_instance_handler.cpp | xdg-shell.h |> clang++ -MJ %B.json -fPIC -O0 -g --std=c++26 -c -I$(HANDLER_INCLUDE_PATH) -o %o %f |> %B.o | %B.json {objs}

: {objs} |> clang++ -shared -fPIC $(PKG_LIBS) -o %o %f |> wayland_instance_handler.so